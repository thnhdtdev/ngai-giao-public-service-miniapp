{
    "name": "my-egovernment-app",
    "private": true,
    "version": "1.0.0",
    "description": "Dịch Vụ Công",
    "repository": "",
    "license": "UNLICENSED",
    "browserslist": [
        "Android >= 5",
        "IOS >= 9.3",
        "Edge >= 15",
        "Safari >= 9.1",
        "Chrome >= 49",
        "Firefox >= 31",
        "Samsung >= 5"
    ],
    "scripts": {
        "start": "zmp start",
        "deploy": "zmp deploy",
        "build:css": "postcss src/css/tailwind.css -o src/css/styles.css",
        "start:zalo": "zmp start --zalo-app --ios",
        "prettier": "prettier \"**/*.+(js|json|ts)\"",
        "format": "npm run prettier -- --write",
        "lint": "eslint ./src --ext .js,.ts,.jsx,.tsx",
        "check-format": "npm run prettier -- --list-different --write",
        "precommit": "lint-staged"
    },
    "lint-staged": {
        "*.{js,ts,jsx,tsx}": [
            "eslint --fix"
        ],
        "*.{json,css,scss,html,md}": [
            "prettier --write"
        ]
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "dependencies": {
        "clsx": "^1.2.1",
        "lodash.debounce": "^4.0.8",
        "lucide-react": "^1.31.0",
        "pdfjs-dist": "2.12.313",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-pdf": "^5.7.2",
        "react-router-dom": "^6.8.2",
        "zmp-sdk": "^2.43.4",
        "zmp-ui": "^1.11.5",
        "zustand": "^4.3.6"
    },
    "devDependencies": {
        "@types/node": "^18.14.6",
        "@types/react": "^18.0.28",
        "@types/react-dom": "^18.0.11",
        "@typescript-eslint/eslint-plugin": "^5.61.0",
        "@typescript-eslint/parser": "^5.61.0",
        "@vitejs/plugin-react": "^1.3",
        "autoprefixer": "^10.4.13",
        "eslint": "^8.20.0",
        "eslint-config-airbnb": "^19.0.4",
        "eslint-config-prettier": "8.4.0",
        "eslint-import-resolver-typescript": "^3.5.5",
        "eslint-plugin-jsx-a11y": "6.5.1",
        "eslint-plugin-react": "^7.30.1",
        "eslint-plugin-react-hooks": "^4.6.0",
        "husky": "4",
        "lint-staged": "^13.2.3",
        "postcss": "^8.4.21",
        "postcss-cli": "^10.1.0",
        "prettier": "2.5.1",
        "sass": "^1.58.3",
        "tailwindcss": "^3.2.7",
        "typescript": "^5.1.6",
        "vite": "2.9.15"
    }
}
